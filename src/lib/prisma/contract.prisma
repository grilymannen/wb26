// use prisma-8

// #==============#============#==================================#
// ||    Field    ||   Type    ||              Params             ||
// #==============#============#==================================#
model Todo {
    id              String      @unique @id @onCreate(uuid())
    text            String  
    completed       Boolean     @default(false)
    user            User        @relation(fields: [userid], references: [id])
    userid          String
}

model User {
    id              String      @unique @id @onCreate(uuid())
    name            String 
    hash            String
    messages        Message[]
    refreshtokens   RefreshToken[]
    created_at      DateTime    @default(now())
}

model Forum {
    id              String      @unique @id @onCreate(uuid())
    text            String
    messages        Message[]
    user            User        @relation(fields: [userid], references: [id])
    userid          String      
    created_at      DateTime    @default(now())
}

model Message {
    id              String      @unique @id @onCreate(uuid())
    text            String
    forum           Forum       @relation(fields: [forumid], references: [id])
    forumid         String
    user            User        @relation(fields: [userid], references: [id])
    userid          String
    created_at      DateTime    @default(now())
    updated_at      DateTime    @default(now())
}

model RefreshToken {
    id              String      @unique @id @onCreate(uuid())
    expires         DateTime(as: temporal)
    user            User        @relation(fields: [userid], references: [id])
    userid          String
}